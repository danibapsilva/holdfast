# Copy to ~/.config/holdfast/holdfast.env (chmod 600) and fill in. Holdfast only runs on Sepolia;
# anything else is refused at startup. Never commit the filled-in file.

# A Sepolia RPC endpoint, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
HOLDFAST_RPC_URL=
# A fresh BIP-39 phrase made only for this demo. Never one that has held real money.
HOLDFAST_SEED=
# Printed by scripts/deploy_tusd.py
HOLDFAST_TUSD_ADDRESS=
# MongoDB (Atlas "Connect, Drivers" string). Unset: deals live in memory and vanish on restart.
HOLDFAST_MONGO_URI=
HOLDFAST_MONGO_DB=holdfast

HOLDFAST_ALLOWED_ORIGINS=https://danibapsilva.github.io,http://localhost:3000
HOLDFAST_API_PORT=8710
HOLDFAST_CONFIRMATIONS=2
HOLDFAST_PAYMENT_MINUTES=30
HOLDFAST_DISPUTE_MINUTES=10
HOLDFAST_PER_DEAL_CAP=100
HOLDFAST_PER_DAY_CAP=2000
