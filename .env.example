HOLDFAST_SEED=
HOLDFAST_TUSD_ADDRESS=
HOLDFAST_CONFIRMATIONS=2
HOLDFAST_PAYMENT_MINUTES=30
HOLDFAST_DISPUTE_MINUTES=10
HOLDFAST_PER_DEAL_CAP=100
HOLDFAST_PER_DAY_CAP=2000
